(defpoll anime_data :interval "5s"
  "cd ~/.config/eww/eww-animelist/scripts && source .venv/bin/activate && proxychains python update_widget.py > /dev/null 2>&1; cat ~/.config/eww/eww-animelist/cache/anime_widget.json 2>/dev/null || echo '[]'")

